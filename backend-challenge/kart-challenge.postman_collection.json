{
  "info": {
    "name": "Kart Challenge API",
    "_postman_id": "kart-challenge-api",
    "description": "Food ordering REST API — products, orders, coupon validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "apitest",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "Returns server status and number of loaded coupons"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has status ok', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.equal('ok');",
                  "  pm.expect(body.couponsLoaded).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List All Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/product",
            "description": "Returns all 9 products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array of products', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array');",
                  "  pm.expect(body.length).to.be.greaterThan(0);",
                  "  pm.expect(body[0]).to.have.all.keys('id', 'name', 'category', 'price');",
                  "  // Save first product id for use in other requests",
                  "  pm.collectionVariables.set('firstProductId', body[0].id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/product/waffle-with-berries",
            "description": "Returns a single product by ID"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns correct product', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.equal('waffle-with-berries');",
                  "  pm.expect(body.name).to.equal('Waffle with Berries');",
                  "  pm.expect(body.price).to.equal(6.5);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Product — 404 Not Found",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/product/nonexistent-product",
            "description": "Returns 404 for unknown product ID"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Has error message', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('error');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order — No Coupon",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/order",
            "header": [
              { "key": "api_key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"waffle-with-berries\", \"quantity\": 2 },\n    { \"productId\": \"classic-tiramisu\", \"quantity\": 1 }\n  ]\n}"
            },
            "description": "Places a valid order without a coupon. Total = (6.50 * 2) + 5.50 = 18.50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Order has expected fields', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.be.a('string');",
                  "  pm.expect(body.items).to.be.an('array');",
                  "  pm.expect(body.products).to.be.an('array');",
                  "  pm.expect(body.total).to.equal(18.5);",
                  "  pm.expect(body.discount).to.be.undefined;",
                  "  pm.collectionVariables.set('orderId', body.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Place Order — With Valid Coupon",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/order",
            "header": [
              { "key": "api_key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"waffle-with-berries\", \"quantity\": 1 }\n  ],\n  \"couponCode\": \"HAPPYHRS\"\n}"
            },
            "description": "Places order with valid coupon HAPPYHRS. 10% discount applied. Total = 6.50 * 0.9 = 5.85"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Discount applied', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.discount).to.equal(10);",
                  "  pm.expect(body.total).to.equal(5.85);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Place Order — With Another Valid Coupon",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/order",
            "header": [
              { "key": "api_key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"red-velvet-cake\", \"quantity\": 2 }\n  ],\n  \"couponCode\": \"FIFTYOFF\"\n}"
            },
            "description": "Places order with valid coupon FIFTYOFF. Total = (4.50 * 2) * 0.9 = 8.10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Discount applied', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.discount).to.equal(10);",
                  "  pm.expect(body.total).to.equal(8.1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Place Order — 401 No API Key",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/order",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"waffle-with-berries\", \"quantity\": 1 }\n  ]\n}"
            },
            "description": "Returns 401 when api_key header is missing"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Has error message', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('error');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Place Order — 401 Wrong API Key",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/order",
            "header": [
              { "key": "api_key", "value": "wrongkey" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"waffle-with-berries\", \"quantity\": 1 }\n  ]\n}"
            },
            "description": "Returns 401 when api_key header is wrong"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Place Order — 422 Invalid Coupon (not in files)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/order",
            "header": [
              { "key": "api_key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"waffle-with-berries\", \"quantity\": 1 }\n  ],\n  \"couponCode\": \"SUPER100\"\n}"
            },
            "description": "Returns 422 for coupon that exists but is only in 1 file (SUPER100 is example invalid code)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "pm.test('Has error message', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('error');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Place Order — 422 Coupon Too Short",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/order",
            "header": [
              { "key": "api_key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"waffle-with-berries\", \"quantity\": 1 }\n  ],\n  \"couponCode\": \"SHORT\"\n}"
            },
            "description": "Returns 422 for coupon shorter than 8 characters"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Place Order — 422 Coupon Too Long",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/order",
            "header": [
              { "key": "api_key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"waffle-with-berries\", \"quantity\": 1 }\n  ],\n  \"couponCode\": \"TOOLONGCOUPONCODE\"\n}"
            },
            "description": "Returns 422 for coupon longer than 10 characters"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Place Order — 404 Unknown Product",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/order",
            "header": [
              { "key": "api_key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"nonexistent-product\", \"quantity\": 1 }\n  ]\n}"
            },
            "description": "Returns 404 when a product in the order doesn't exist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Place Order — 400 Empty Items",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/order",
            "header": [
              { "key": "api_key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": []\n}"
            },
            "description": "Returns 400 when items array is empty"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Place Order — 400 Missing Items Field",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/order",
            "header": [
              { "key": "api_key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"couponCode\": \"HAPPYHRS\"\n}"
            },
            "description": "Returns 400 when items field is missing entirely"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
